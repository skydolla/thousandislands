# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (database + login) ---
# Project Settings → Data API → "API URL", e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → Publishable key (sb_publishable_...). Safe for browsers and the iOS app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings → API Keys → Secret key (sb_secret_...). Server only; never expose to the browser.
SUPABASE_SECRET_KEY=
# Connect (top bar) → Session pooler connection string, with your database password filled in.
# Used for migrations and backups only.
SUPABASE_DB_URL=

# --- Cloudflare R2 (photos) ---
# R2 overview page → Account ID
R2_ACCOUNT_ID=
# R2 → Manage API tokens → Object Read & Write token scoped to the bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=thousandislands-photos
# Bucket → Settings → Public access → R2.dev subdomain, e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=
